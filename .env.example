# Copie para .env. Nenhum valor abaixo identifica uma instalação real.
# Bun carrega .env; Docker Compose interpola este arquivo na raiz.
COMPOSE_FILE=infra/compose.yaml
NODE_ENV=development
BIND_ADDRESS=127.0.0.1
PORT=8080
HOSTNAME=127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
APP_AUTH_MODE=none
APP_ALLOWED_USERS=
APP_ORIGIN=
SERVE_SOCKET_DIRECTORY=
TAILSCALE_ADDRESS=
YOUTUBE_COOKIES_FILE=
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_MODE=disabled
YTDLP_BINARY=yt-dlp
YTDLP_JS_RUNTIMES=bun
YTDLP_PROXY=
TEMP_DIR=
TRUST_PROXY=0
MAX_DURATION_SECONDS=7200
MAX_FILESIZE_BYTES=268435456
MIN_FREE_BYTES=268435456
INSPECT_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=900000
MAX_CONCURRENT_DOWNLOADS=1
RATE_LIMIT_INSPECT_PER_MINUTE=20
RATE_LIMIT_DOWNLOAD_PER_MINUTE=5
PERFORMANCE_METADATA_CACHE=1
YTDLP_FRAGMENT_CONCURRENCY=4
# Opcional: caminho das fontes históricas para a matriz de benchmarks.
BENCH_ROOT=
